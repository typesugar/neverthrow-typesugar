{
  "name": "neverthrow-typesugar-case-study",
  "private": true,
  "type": "module",
  "description": "Tooling for the neverthrow x typesugar case study (see CASE-STUDY.md). Holds the typesugar dependencies, and the TypeScript version typesugar needs (>=5.9), so the root manifest and lockfile stay as neverthrow ships them.",
  "devDependencies": {
    "@typesugar/contracts": "file:../vendor/typesugar/typesugar-contracts-0.1.1-3e055859.tgz",
    "@typesugar/core": "file:../vendor/typesugar/typesugar-core-0.1.1-3e055859.tgz",
    "@typesugar/derive": "file:../vendor/typesugar/typesugar-derive-0.1.1-3e055859.tgz",
    "@typesugar/fp": "file:../vendor/typesugar/typesugar-fp-0.1.1-3e055859.tgz",
    "@typesugar/lsp-common": "file:../vendor/typesugar/typesugar-lsp-common-0.1.1-3e055859.tgz",
    "@typesugar/macros": "file:../vendor/typesugar/typesugar-macros-0.1.1-3e055859.tgz",
    "@typesugar/reflect": "file:../vendor/typesugar/typesugar-reflect-0.1.1-3e055859.tgz",
    "@typesugar/std": "file:../vendor/typesugar/typesugar-std-0.1.1-3e055859.tgz",
    "@typesugar/transformer": "file:../vendor/typesugar/typesugar-transformer-0.1.1-3e055859.tgz",
    "@typesugar/transformer-core": "file:../vendor/typesugar/typesugar-transformer-core-0.1.1-3e055859.tgz",
    "@typesugar/type-system": "file:../vendor/typesugar/typesugar-type-system-0.1.1-3e055859.tgz",
    "@typesugar/typeclass": "file:../vendor/typesugar/typesugar-typeclass-0.1.1-3e055859.tgz",
    "@typesugar/validate": "file:../vendor/typesugar/typesugar-validate-0.1.1-3e055859.tgz",
    "typescript": "5.9.3",
    "typesugar": "file:../vendor/typesugar/typesugar-0.1.1-3e055859.tgz",
    "unplugin-typesugar": "file:../vendor/typesugar/unplugin-typesugar-0.1.1-3e055859.tgz"
  },
  "overrides": {
    "@typesugar/contracts": "$@typesugar/contracts",
    "@typesugar/core": "$@typesugar/core",
    "@typesugar/derive": "$@typesugar/derive",
    "@typesugar/fp": "$@typesugar/fp",
    "@typesugar/lsp-common": "$@typesugar/lsp-common",
    "@typesugar/macros": "$@typesugar/macros",
    "@typesugar/reflect": "$@typesugar/reflect",
    "@typesugar/std": "$@typesugar/std",
    "@typesugar/transformer": "$@typesugar/transformer",
    "@typesugar/transformer-core": "$@typesugar/transformer-core",
    "@typesugar/type-system": "$@typesugar/type-system",
    "@typesugar/typeclass": "$@typesugar/typeclass",
    "@typesugar/validate": "$@typesugar/validate",
    "typesugar": "$typesugar",
    "unplugin-typesugar": "$unplugin-typesugar"
  }
}
